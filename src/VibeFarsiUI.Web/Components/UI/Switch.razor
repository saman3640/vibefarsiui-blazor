@* Ported from registry/ui/switch.tsx. *@
@if (!string.IsNullOrEmpty(Label) || !string.IsNullOrEmpty(Description))
{
    <div class="vf-switch-row">
        <span class="vf-check__text">
            @if (!string.IsNullOrEmpty(Label))
            {
                <span>@Label</span>
            }
            @if (!string.IsNullOrEmpty(Description))
            {
                <small class="vf-muted">@Description</small>
            }
        </span>
        @RenderSwitch
    </div>
}
else
{
    @RenderSwitch
}

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private RenderFragment RenderSwitch => __builder =>
    {
        <button type="button"
                class="vf-switch @Class"
                role="switch"
                aria-checked="@(Checked ? "true" : "false")"
                aria-label="@(string.IsNullOrEmpty(AriaLabel) ? Label : AriaLabel)"
                disabled="@Disabled"
                @onclick="ToggleAsync">
            <span class="vf-switch__thumb"></span>
        </button>
    };

    private async Task ToggleAsync()
    {
        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }
}
