@* Ported from registry/ui/alert.tsx. *@
<div class="vf-alert @VariantClass @Class" role="@(Variant == "destructive" ? "alert" : "status")" @attributes="AdditionalAttributes">
    @if (ShowIcon)
    {
        <LucideIcon Name="@Icon" Size="17" />
    }
    <div>
        @if (!string.IsNullOrEmpty(Title))
        {
            <strong class="vf-alert__title">@Title</strong>
        }
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Variant { get; set; } = "info";
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Css.Join("vf-alert--" + Variant);

    private string Icon => Variant switch
    {
        "success" => "check-circle",
        "warning" => "alert-triangle",
        "destructive" => "alert-circle",
        _ => "info"
    };
}
