@* Ported from registry/ui/radio-group.tsx. *@
<div class="vf-radio-group" role="radiogroup" aria-label="@Label">
    @foreach (var option in Options)
    {
        <label class="vf-radio">
            <input type="radio"
                   name="@Name"
                   value="@option.Value"
                   checked="@(option.Value == Value)"
                   disabled="@(Disabled || option.Disabled)"
                   @onchange="() => SelectAsync(option.Value)" />
            <span class="vf-radio__dot" aria-hidden="true"></span>
            <span>
                @option.Label
                @if (!string.IsNullOrEmpty(option.Description))
                {
                    <small>@option.Description</small>
                }
            </span>
        </label>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<RadioOption> Options { get; set; } = [];
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Name { get; set; } = $"vf-radio-{Guid.NewGuid():N}";
    [Parameter] public bool Disabled { get; set; }

    private async Task SelectAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
