@* Ported from registry/ui/checkbox.tsx. *@
<label class="vf-check @Class">
    <input type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           aria-invalid="@(!string.IsNullOrEmpty(Error) ? "true" : null)"
           @onchange="OnChangeAsync"
           @attributes="AdditionalAttributes" />
    <span class="vf-check__box" aria-hidden="true">
        @if (Checked)
        {
            <LucideIcon Name="check" Size="12" StrokeWidth="3" />
        }
    </span>
    @if (ChildContent is not null || !string.IsNullOrEmpty(Label))
    {
        <span class="vf-check__text">
            @if (!string.IsNullOrEmpty(Label))
            {
                @Label
            }
            @ChildContent
            @if (!string.IsNullOrEmpty(Description))
            {
                <small>@Description</small>
            }
        </span>
    }
</label>
@if (!string.IsNullOrEmpty(Error))
{
    <span class="vf-error" role="alert">@Error</span>
}

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnChangeAsync(ChangeEventArgs args)
    {
        Checked = args.Value is bool value ? value : args.Value?.ToString() == "true";
        await CheckedChanged.InvokeAsync(Checked);
    }
}
