@* Ported from registry/ui/phone-input.tsx — Iranian mobile normalization and operator label. *@
<div class="vf-field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="vf-label" for="@Id">@Label</label>
    }
    <div class="vf-input-wrap" data-invalid="@(ShowError ? "true" : null)">
        <LucideIcon Name="smartphone" Size="16" Class="vf-muted" />
        <input id="@Id"
               class="vf-input"
               type="tel"
               dir="ltr"
               inputmode="numeric"
               autocomplete="tel"
               maxlength="13"
               value="@_display"
               placeholder="0912 345 6789"
               aria-invalid="@(ShowError ? "true" : null)"
               @oninput="OnInputAsync" />
        @if (!string.IsNullOrEmpty(Operator))
        {
            <Badge Variant="secondary">@Operator</Badge>
        }
    </div>
    @if (ShowError)
    {
        <span class="vf-error" role="alert">شماره موبایل معتبر نیست.</span>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <span class="vf-hint">@Hint</span>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; } = "شماره موبایل";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Id { get; set; } = $"vf-phone-{Guid.NewGuid():N}";
    [Parameter] public bool ShowValidation { get; set; } = true;

    private string _display = string.Empty;

    protected override void OnParametersSet()
    {
        _display = Format(IranianValidation.NormalizeMobile(Value));
    }

    private bool ShowError => ShowValidation && !string.IsNullOrEmpty(Value) && !IranianValidation.IsMobile(Value);

    private string? Operator => IranianValidation.IsMobile(Value) ? IranianValidation.MobileOperator(Value) : null;

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        var normalized = IranianValidation.NormalizeMobile(args.Value?.ToString());
        _display = Format(normalized);
        Value = normalized;
        await ValueChanged.InvokeAsync(Value);
    }

    private static string Format(string digits)
    {
        if (digits.Length == 0) return string.Empty;
        var local = digits.StartsWith("98") ? digits[2..] : digits;
        if (local.Length > 0 && local[0] != '0') local = "0" + local;
        var parts = new[] { local.Length > 4 ? local[..4] : local, local.Length > 7 ? local[4..7] : local.Length > 4 ? local[4..] : "", local.Length > 7 ? local[7..] : "" };
        return PersianText.Fa(string.Join(' ', parts.Where(p => p.Length > 0)));
    }
}
